# Local development only. Start MongoDB as a single-node replica set named rs0
# because BillFlow uses MongoDB transactions for multi-document business operations.
MONGODB_URI=mongodb://127.0.0.1:27017/billflow?replicaSet=rs0
MONGODB_DATABASE=billflow

# Cloudflare R2 (S3-compatible private object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# External daily-reminder scheduler token. Keep the internal scheduler disabled
# when running more than one application instance.
SCHEDULED_JOB_TOKEN=
ENABLE_INTERNAL_SCHEDULER=false

# Optional application-only signing secret
BILLFLOW_JWT_SECRET=
